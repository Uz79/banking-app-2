{
  "name": "slider",
  "category": "selection-control",
  "description": "Slider input for selecting a numeric value along a range.",
  "variants": [
    "regular",
    "small",
    "x-small"
  ],
  "interactionStates": [
    "default"
  ],
  "assets": {
    "overview": "variants/regular-default/default.svg",
    "variants": {
      "regular-default": {
        "default": "variants/regular-default/default.svg"
      },
      "small-default": {
        "default": "variants/small-default/default.svg"
      },
      "x-small-default": {
        "default": "variants/x-small-default/default.svg"
      }
    }
  },
  "tokens": {
    "radius": "alias.radius.pill",
    "modes": {
      "light": {
        "foreground": "mapped/light.foreground.foreground",
        "foregroundSecondary": "mapped/light.foreground.foreground-disabled"
      },
      "dark": {
        "foreground": "mapped/dark.foreground.foreground",
        "foregroundSecondary": "mapped/dark.foreground.foreground-disabled"
      }
    }
  },
  "accessibility": {
    "role": "slider",
    "needsAccessibleName": true,
    "keyboardFocusable": true
  },
  "notes": [
    "Default-state exports are currently available for regular, small, and x-small sizes.",
    "Thumb is a pill (rounded rect), not a circle.",
    "Previous single-variant pill export archived under _archive/2026-08-12/.",
    "Previous circular-thumb export archived under _archive/2026-07-13/."
  ]
}
